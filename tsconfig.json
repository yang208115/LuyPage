{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "vite/client",
      "node",
      "@cloudflare/vitest-plugin/types"
    ],
    "paths": {
      "@luypage/contracts": [
        "./packages/contracts/src/index.ts"
      ],
      "@luypage/domain": [
        "./packages/domain/src/index.ts"
      ],
      "@luypage/persistence": [
        "./packages/persistence/src/index.ts"
      ],
      "@luypage/storage": [
        "./packages/storage/src/index.ts"
      ]
    }
  },
  "include": [
    "apps",
    "packages",
    "tests",
    "*.config.ts",
    "types"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "apps/web/dist"
  ]
}
